[gd_resource type="SfxBank" format=3 uid="uid://mqce7mtv0y7s"]

[ext_resource type="Script" uid="uid://4tpinwjxy16c" path="res://demo_tone_generator_playback.gd" id="5_tone"]

[sub_resource type="SfxGeneratorPlayback" id="Resource_tone"]
script = ExtResource("5_tone")

[sub_resource type="AudioStreamGenerator" id="AudioStreamGenerator_rpm_a"]
buffer_length = 0.12

[sub_resource type="SfxClip" id="Resource_engine_rpm_low"]
stream = SubResource("AudioStreamGenerator_rpm_a")
generator_playback = SubResource("Resource_tone")
length = 350.0

[sub_resource type="AudioStreamGenerator" id="AudioStreamGenerator_rpm_b"]
buffer_length = 0.12

[sub_resource type="SfxClip" id="Resource_engine_rpm_high"]
stream = SubResource("AudioStreamGenerator_rpm_b")
generator_playback = SubResource("Resource_tone")
offset = 400.0
length = 600.0
phase_offset = 0.1

[sub_resource type="SfxAutomation" id="Resource_engine_rpm"]
parameter_name = &"rpm"
clips = Array[SfxClip]([SubResource("Resource_engine_rpm_low"), SubResource("Resource_engine_rpm_high")])
max_domain = 1000.0

[sub_resource type="AudioStreamGenerator" id="AudioStreamGenerator_intensity"]
buffer_length = 0.12

[sub_resource type="SfxClip" id="Resource_engine_intensity"]
stream = SubResource("AudioStreamGenerator_intensity")
generator_playback = SubResource("Resource_tone")
length = 1.0

[sub_resource type="SfxAutomation" id="Resource_engine_load"]
parameter_name = &"load"
clips = Array[SfxClip]([SubResource("Resource_engine_intensity")])

[sub_resource type="AudioStreamGenerator" id="AudioStreamGenerator_intro"]
buffer_length = 0.12

[sub_resource type="SfxClip" id="Resource_engine_intro"]
stream = SubResource("AudioStreamGenerator_intro")
generator_playback = SubResource("Resource_tone")
length = 0.6

[sub_resource type="AudioStreamGenerator" id="AudioStreamGenerator_body"]
buffer_length = 0.12

[sub_resource type="SfxClip" id="Resource_engine_body"]
stream = SubResource("AudioStreamGenerator_body")
generator_playback = SubResource("Resource_tone")
offset = 0.45
length = 1.8

[sub_resource type="SfxEvent" id="Resource_engine_event"]
clips = Array[SfxClip]([SubResource("Resource_engine_intro"), SubResource("Resource_engine_body")])
name = &"engine_loop"
automations = Array[SfxAutomation]([SubResource("Resource_engine_rpm"), SubResource("Resource_engine_load")])

[resource]
events = Array[SfxEvent]([SubResource("Resource_engine_event")])
