; The playback engine of gnd_sfx (src/). A library loads only into an engine of its own precision:
; the ".double" entries are Rails Reloaded's double precision Godot, picked by the "double" tag
[configuration]

entry_symbol = "gndsfx_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/gnd_sfx/bin/linux/libgndsfx.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/gnd_sfx/bin/linux/libgndsfx.linux.template_release.x86_64.so"
linux.debug.x86_64.double = "res://addons/gnd_sfx/bin/linux/libgndsfx.linux.template_debug.double.x86_64.so"
linux.release.x86_64.double = "res://addons/gnd_sfx/bin/linux/libgndsfx.linux.template_release.double.x86_64.so"
windows.debug.x86_64 = "res://addons/gnd_sfx/bin/windows/libgndsfx.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/gnd_sfx/bin/windows/libgndsfx.windows.template_release.x86_64.dll"
windows.debug.x86_64.double = "res://addons/gnd_sfx/bin/windows/libgndsfx.windows.template_debug.double.x86_64.dll"
windows.release.x86_64.double = "res://addons/gnd_sfx/bin/windows/libgndsfx.windows.template_release.double.x86_64.dll"
android.debug.arm64 = "res://addons/gnd_sfx/bin/android/libgndsfx.android.template_debug.arm64.so"
android.release.arm64 = "res://addons/gnd_sfx/bin/android/libgndsfx.android.template_release.arm64.so"
android.debug.arm64.double = "res://addons/gnd_sfx/bin/android/libgndsfx.android.template_debug.double.arm64.so"
android.release.arm64.double = "res://addons/gnd_sfx/bin/android/libgndsfx.android.template_release.double.arm64.so"
